# Copy this file to `.env` (gitignored) before running `docker compose up`.
# Compose reads `.env` automatically from the project directory.

# Gemini model access for the backend agent.
GEMINI_API_KEY=

# Optional LangSmith/LangSmith tracing.
LANGSMITH_API_KEY=

# Password for the local langgraph-postgres container.
# Compose refuses to start until this is set to a non-empty value.
# Generate one with e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
